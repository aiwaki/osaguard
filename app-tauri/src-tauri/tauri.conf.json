{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OsaGuard",
  "version": "0.1.3-preview.1",
  "identifier": "dev.aiwaki.osaguard",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OsaGuard",
        "width": 760,
        "height": 720,
        "center": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "Automatic confirmation for AppleScript administrator dialogs",
    "longDescription": "OsaGuard is a macOS menu-bar utility that can automatically confirm AppleScript administrator password dialogs after one-time setup.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  }
}
